# Spring Boot backend — read from the process environment at startup.
# These mirror the defaults in backend-java/src/main/resources/application.properties.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/phonebook_db
DATABASE_USERNAME=phonebook_user
DATABASE_PASSWORD=phonebook_password
# PORT=8080   (optional; the backend defaults to 8080 when unset)

# Vite frontend — API base path. API requests go through Nginx (/api -> :8080),
# so the frontend always talks to the same origin. Defaults to '/api' if unset.
VITE_API_BASE_URL=/api
